# =============================================================================
# Recommended stack: Groq (LLM) + ModelScope (embeddings) — no OpenAI required
# =============================================================================
# Leave OPENAI_API_KEY empty or delete the line when using only Groq + ModelScope.

OPENAI_API_KEY=

GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
# Optional comma-separated fallback models (used after GROQ_MODEL)
GROQ_MODEL_CANDIDATES=llama-3.3-70b-versatile
GROQ_API_KEY=
# Optional comma-separated backup Groq API keys for automatic rotation on 429/rate-limit.
GROQ_API_KEYS=

# Chat LLM chain (OpenAI-compatible). Order is configurable via LLM_PROVIDER_ORDER.
# For lower latency, prefer Groq first: LLM_PROVIDER_ORDER=groq,nvidia,modelscope,openai
NVIDIA_CHAT_API_KEY=
NVIDIA_CHAT_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=google/gemma-2-9b-it
# Optional comma-separated fallback NVIDIA chat models.
NVIDIA_CHAT_MODEL_CANDIDATES=meta/llama-3.1-70b-instruct
MODELSCOPE_CHAT_API_KEY=
MODELSCOPE_CHAT_BASE=
MODELSCOPE_CHAT_MODEL=stepfun-ai/Step-3.5-Flash
LLM_PROVIDER_ORDER=groq,nvidia,modelscope,openai
LLM_REQUEST_TIMEOUT_SECONDS=15
LLM_STREAM_FIRST_TOKEN_TIMEOUT_SECONDS=6

# Increase if you see chat responses cut off mid-sentence (finish_reason="length").
LLM_MAX_TOKENS=1600

# ModelScope OpenAI-compatible embeddings (Qwen3). Use a NEW Pinecone index if dimension changes.
EMBEDDING_API_BASE=https://api-inference.modelscope.ai/v1
EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
PINECONE_EMBEDDING_DIMENSION=4096

# NVIDIA NIM embeddings (alternative if ModelScope fails). If set, overrides EMBEDDING_API_BASE.
# Model outputs 2048-d vectors — use PINECONE_EMBEDDING_DIMENSION=2048 and a dedicated index name.
# https://build.nvidia.com / integrate.api.nvidia.com OpenAI-compatible /v1/embeddings
NVIDIA_EMBEDDING_API_KEY=
NVIDIA_EMBEDDING_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/llama-3.2-nemoretriever-300m-embed-v1

# Alternative embeddings: OpenAI only — set OPENAI_API_KEY and use text-embedding-3-small + 1536 dims (comment out ModelScope block above).

# Pinecone
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=ai-persona
PINECONE_ENVIRONMENT=us-east-1

# Vapi
VAPI_API_KEY=...
VAPI_PHONE_NUMBER_ID=...
VAPI_ASSISTANT_ID=...

# Cal.com — EVENT_TYPE_ID must be numeric (v2). See Cal.com dashboard / API docs.
CALCOM_API_KEY=...
CALCOM_EVENT_TYPE_ID=...
CALCOM_USERNAME=...
CALCOM_TIMEZONE=Asia/Kolkata

# GitHub
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=...

# ElevenLabs
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# App
BACKEND_URL=http://localhost:8000
# Frontend: leave NEXT_PUBLIC_API_URL empty locally so the Next.js dev server proxies /api to BACKEND_URL.
# For Vercel, set BACKEND_URL to your public FastAPI URL (rewrites use it).
FRONTEND_URL=http://localhost:3000
CHAT_URL=http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO

PERSONA_NAME=Your Name
PERSONA_ROLE=AI/ML Engineer
